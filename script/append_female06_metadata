#!/usr/bin/env python3
import argparse
import csv
from pathlib import Path


def read_entries(entries_path: Path) -> list[list[str]]:
    rows: list[list[str]] = []
    with entries_path.open("r", encoding="utf-8", newline="") as csv_file:
        reader = csv.reader(csv_file, delimiter="|")
        for raw in reader:
            if not raw:
                continue
            if raw[0].strip().startswith("#"):
                continue

            if len(raw) < 2:
                raise ValueError(
                    f"Invalid row in {entries_path}: expected filename|text, got {raw}"
                )

            filename = raw[0].strip()
            text = "|".join(raw[1:]).strip()
            if not filename or not text:
                raise ValueError(
                    f"Invalid row in {entries_path}: filename and text are required"
                )

            rows.append([filename, text])

    return rows


def load_existing(metadata_path: Path) -> list[list[str]]:
    if not metadata_path.exists():
        return []

    rows: list[list[str]] = []
    with metadata_path.open("r", encoding="utf-8", newline="") as csv_file:
        reader = csv.reader(csv_file, delimiter="|")
        for raw in reader:
            if not raw:
                continue

            filename = raw[0].strip()
            text = "|".join(raw[1:]).strip() if len(raw) > 1 else ""
            if filename:
                rows.append([filename, text])

    return rows


def main() -> None:
    parser = argparse.ArgumentParser(
        description=(
            "Append or update metadata entries for female06 Italian dataset. "
            "Entries file format: filename.wav|Exact transcript"
        )
    )
    parser.add_argument("--dataset-dir", default="training_data/female06_it")
    parser.add_argument(
        "--entries-file",
        default="training_data/female06_it/entries_to_add.csv",
        help="CSV file with | delimiter and rows filename|text",
    )
    parser.add_argument(
        "--fail-missing-audio",
        action="store_true",
        help="Fail if an entry references an audio file missing from dataset audio dir",
    )
    args = parser.parse_args()

    repo_dir = Path(__file__).resolve().parent.parent

    dataset_dir = Path(args.dataset_dir)
    if not dataset_dir.is_absolute():
        dataset_dir = repo_dir / dataset_dir

    entries_file = Path(args.entries_file)
    if not entries_file.is_absolute():
        entries_file = repo_dir / entries_file

    if not entries_file.exists():
        raise FileNotFoundError(
            f"Entries file not found: {entries_file}. Create it with filename|transcript rows."
        )

    audio_dir = dataset_dir / "audio"
    metadata_path = dataset_dir / "metadata.csv"

    if not audio_dir.exists():
        raise FileNotFoundError(
            f"Audio directory not found: {audio_dir}. Run script/prepare_female06_dataset first."
        )

    new_rows = read_entries(entries_file)
    existing_rows = load_existing(metadata_path)

    by_name: dict[str, str] = {row[0]: row[1] for row in existing_rows}

    added = 0
    updated = 0
    missing_audio: list[str] = []

    for filename, text in new_rows:
        audio_path = audio_dir / filename
        if not audio_path.exists():
            missing_audio.append(filename)
            if args.fail_missing_audio:
                continue

        if filename in by_name:
            if by_name[filename] != text:
                by_name[filename] = text
                updated += 1
        else:
            by_name[filename] = text
            added += 1

    merged_rows = [[name, text] for name, text in by_name.items()]
    merged_rows.sort(key=lambda row: row[0])

    metadata_path.parent.mkdir(parents=True, exist_ok=True)
    with metadata_path.open("w", encoding="utf-8", newline="") as csv_file:
        writer = csv.writer(csv_file, delimiter="|")
        writer.writerows(merged_rows)

    print(f"Updated metadata: {metadata_path}")
    print(f"Total rows: {len(merged_rows)}")
    print(f"Added: {added}")
    print(f"Updated: {updated}")

    if missing_audio:
        print("WARNING: missing audio files for these rows:")
        for filename in missing_audio:
            print(f"- {filename}")
        if args.fail_missing_audio:
            raise FileNotFoundError(
                "One or more entries reference missing audio. See warnings above."
            )


if __name__ == "__main__":
    main()
