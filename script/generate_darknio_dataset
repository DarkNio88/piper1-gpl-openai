#!/usr/bin/env python3
import csv
import re
import sys
import time
import urllib.parse
import urllib.request
import wave
from pathlib import Path


def split_utterances(text: str) -> list[tuple[str, str]]:
    """Split text into many short utterances."""
    paragraphs = [p.strip() for p in text.split('\n\n') if p.strip()]
    items: list[tuple[str, str]] = []
    utt_id = 0

    for para in paragraphs:
        sents = re.split(r'(?<=[.!?:])\s+', para)
        sents = [s.strip() for s in sents if s.strip()]
        for sent in sents:
            # whole sentence
            utt_id += 1
            items.append((f'female06_darknio_{utt_id:04d}.wav', sent))

            # fragments by comma
            fragments = [f.strip() for f in sent.split(',') if f.strip()]
            if len(fragments) > 1:
                for frag in fragments:
                    wds = frag.split()
                    if len(wds) >= 2:
                        utt_id += 1
                        items.append((f'female06_darknio_{utt_id:04d}.wav', frag))

            # short 5-8 word sliding chunks for variety
            wds = sent.split()
            if len(wds) > 8:
                for start in range(0, len(wds), 6):
                    chunk = ' '.join(wds[start:start+8])
                    if len(chunk.split()) >= 3:
                        utt_id += 1
                        items.append((f'female06_darknio_{utt_id:04d}.wav', chunk))

    return items


def main() -> None:
    repo = Path(__file__).resolve().parent.parent
    dataset = repo / 'training_data/female06_it'
    src = dataset / 'source_text.txt'
    audio_dir = dataset / 'audio'
    entries_path = dataset / 'entries_to_add.csv'

    base_url = 'http://www2.darknio.ovh/tts_wav.php?text='
    text = src.read_text(encoding='utf-8')

    utterances = split_utterances(text)
    print(f'Total utterances to download: {len(utterances)}')

    ok = 0
    fail = 0
    start = time.time()

    # Open entries file and write incrementally
    with entries_path.open('w', encoding='utf-8', newline='') as ef:
        w = csv.writer(ef, delimiter='|')

        for idx, (fn, utt_text) in enumerate(utterances, start=1):
            url = base_url + urllib.parse.quote(utt_text, safe='')
            out = audio_dir / fn
            success = False

            # Try darknio up to 3 times per chunk
            for attempt in range(3):
                try:
                    with urllib.request.urlopen(url, timeout=None) as resp:
                        data = resp.read()
                    if data[:4] == b'RIFF':
                        with wave.open(str(out), 'rb') as wf:
                            if wf.getnframes() > 0 and wf.getframerate() > 0:
                                out.write_bytes(data)
                                success = True
                                break
                except Exception:
                    if attempt < 2:
                        time.sleep(1)

            if success:
                ok += 1
                w.writerow([fn, utt_text])
                ef.flush()
            else:
                fail += 1

            elapsed = time.time() - start

            # Print progress every 5 items, on failures, and at end
            if idx % 5 == 0 or idx == len(utterances) or not success:
                eta = ''
                if ok > 0 and elapsed > 0:
                    rate = elapsed / idx
                    remaining = (len(utterances) - idx) * rate
                    eta = f' eta={remaining:.0f}s'
                print(f'[{idx}/{len(utterances)}] ok={ok} fail={fail} elapsed={elapsed:.0f}s{eta}')

    total = time.time() - start
    print(f'\nDone! ok={ok} fail={fail} total_time={total:.0f}s')
    print(f'Entries file: {entries_path}')


if __name__ == '__main__':
    main()
